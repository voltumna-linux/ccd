#!/usr/bin/env bash

set -euo pipefail
trap 'printf "Errore alla riga %s\n" "$LINENO" >&2' ERR

read -r -d '' DATI <<'EOF' || true
s-d1718t-x12sdv-4c-sp6f image ccd-sde intranet tar
s-d1718t-x12sdv-4c-sp6f image ccd-sre intranet tar
s-d1718t-x12sdv-4c-sp6f sdk   ccd-sdk intranet sh
d-6346-06v45n-gof       image ccd-sde intranet tar
d-6346-06v45n-gof       image ccd-sre intranet tar
d-6346-06v45n-gof       sdk   ccd-sdk intranet sh
d-9755-h14dsh-fast      image ccd-sde intranet tar
d-9755-h14dsh-fast      image ccd-sre intranet tar
d-9755-h14dsh-fast      sdk   ccd-sdk intranet sh
EOF

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    exec 3<<< "$DATI"

    while read -r -u 3 machine type image outputdir format; do
        export MACHINE="$machine"

        case "$type" in
            image)
                nice bitbake -k "$image" -c rootfs
                ;;
            sdk)
                ;;
            *)
                printf 'Type unknown: %s\n' "$type" >&2
                exit 1
                ;;
        esac
    done

    exec 3<&-
fi
